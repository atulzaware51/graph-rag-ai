GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# LLM provider priority. Missing keys are skipped automatically.
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=groq,mistral
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Optional persistent graph database URL. Defaults to local SQLite.
DATABASE_URL=

# Set these three values to enable Neo4j Aura graph persistence.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# Defaults to "neo4j" when blank.
NEO4J_DATABASE=
# Optional Aura dashboard metadata; not used for authentication.
AURA_INSTANCEID=
AURA_INSTANCENAME=
