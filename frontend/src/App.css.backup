
/* =========================================
   GraphSheet AI — Application Layout
   ========================================= */

.app-shell {
  min-height: 100vh;
  display: flex;
  background: #f6f7f9;
  color: #202938;
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  font-size: 14px;
}

/* Sidebar */

.sidebar {
  width: 248px;
  flex: 0 0 248px;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 22px 14px 14px;
  box-sizing: border-box;
  background: #202833;
  color: #c2cbd6;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  width: 100%;
  padding: 0 8px;
  border: 0;
  background: transparent;
  color: #fff;
  text-align: left;
  cursor: pointer;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  border-radius: 11px;
  background: #3266c7;
  color: white;
  font-size: 23px;
  font-weight: 750;
}

.brand-copy,
.workspace-copy,
.profile-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4px;
}

.brand-copy strong {
  font-size: 15px;
  letter-spacing: -0.35px;
}

.brand-copy small {
  color: #8d9bab;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.3px;
}

.workspace-switcher {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 31px 0 27px;
  padding: 12px 9px;
  border: 1px solid #3a4553;
  border-radius: 9px;
  background: #28323f;
}

.workspace-avatar {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  border-radius: 8px;
  background: #394c64;
  color: #fff;
  font-weight: 700;
}

.workspace-copy {
  flex: 1;
}

.workspace-copy strong,
.profile-copy strong {
  overflow: hidden;
  color: #edf1f6;
  font-size: 12px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workspace-copy small,
.profile-copy small {
  color: #91a0b1;
  font-size: 10px;
}

.switcher-arrow {
  color: #a9b5c3;
  font-size: 19px;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 29px;
}

.nav-group {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nav-heading {
  margin: 0 0 9px 11px;
  color: #8996a6;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 1.2px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 42px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 7px;
  background: transparent;
  color: #b8c2ce;
  text-align: left;
  font: inherit;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.nav-item:hover {
  background: #2b3745;
  color: #fff;
}

.nav-item.active {
  border-color: #3a5274;
  background: #30435d;
  color: #fff;
}

.nav-item.active .nav-icon {
  color: #9fc2ff;
}

.nav-icon {
  display: inline-grid;
  width: 19px;
  place-items: center;
  color: #9cabbc;
  font-size: 17px;
}

.sidebar-bottom {
  margin-top: auto;
}

.connection-status {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 22px 3px 17px;
  padding: 13px 10px;
  border: 1px solid #3a4553;
  border-radius: 8px;
  background: #26313e;
}

.status-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  margin-top: 4px;
  border-radius: 50%;
  background: #d9a94e;
}

.connection-status strong,
.connection-status small {
  display: block;
}

.connection-status strong {
  margin-bottom: 5px;
  color: #e1e7ef;
  font-size: 11px;
  font-weight: 600;
}

.connection-status small {
  color: #9ba8b8;
  font-size: 10px;
  line-height: 1.5;
}

.profile {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 15px 4px 3px;
  border-top: 1px solid #3a4553;
}

.profile-avatar {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  place-items: center;
  border-radius: 50%;
  background: #d9e5f8;
  color: #31558a;
  font-weight: 700;
}

.profile-copy {
  flex: 1;
}

.profile-menu {
  color: #a4b0bf;
  letter-spacing: 2px;
}

/* Main workspace */

.main-panel {
  flex: 1;
  min-width: 0;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  height: 66px;
  align-items: center;
  justify-content: space-between;
  padding: 0 36px;
  border-bottom: 1px solid #e5e8ed;
  background: rgba(255, 255, 255, 0.96);
}

.breadcrumbs,
.topbar-actions {
  display: flex;
  align-items: center;
  gap: 13px;
}

.breadcrumbs {
  color: #8490a0;
  font-size: 12px;
}

.breadcrumbs strong {
  color: #303b4b;
  font-weight: 650;
}

.breadcrumb-divider {
  color: #c2c8d1;
}

.environment-label {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #687487;
  font-size: 11px;
}

.environment-label .status-dot {
  margin: 0;
  background: #4d9b77;
}

.help-button {
  display: grid;
  width: 29px;
  height: 29px;
  place-items: center;
  border: 1px solid #e0e5eb;
  border-radius: 50%;
  background: #fff;
  color: #667386;
  font-size: 13px;
  cursor: pointer;
}

.page-content {
  width: 100%;
  max-width: 1440px;
  box-sizing: border-box;
  margin: 0 auto;
  padding: 34px 36px 18px;
}

.welcome-section {
  position: relative;
  display: flex;
  min-height: 177px;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  padding: 26px 31px;
  border: 1px solid #e1e7ef;
  border-radius: 12px;
  background: #fff;
  box-sizing: border-box;
}

.eyebrow {
  margin: 0 0 12px;
  color: #5576a9;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 1.4px;
}

.welcome-section h1,
.placeholder-page h1 {
  margin: 0;
  color: #202938;
  font-size: clamp(25px, 3vw, 34px);
  font-weight: 720;
  letter-spacing: -1.2px;
  line-height: 1.2;
}

.welcome-section h1 span {
  color: #3869bd;
}

.welcome-description {
  max-width: 570px;
  margin: 13px 0 0;
  color: #748093;
  font-size: 13px;
  line-height: 1.8;
}

/* Decorative knowledge graph symbol */

.welcome-symbol {
  position: relative;
  width: 170px;
  height: 130px;
  flex: 0 0 170px;
  margin: 0 28px 0 20px;
}

.symbol-line {
  position: absolute;
  height: 2px;
  transform-origin: left center;
  background: #a8c3eb;
}

.line-one {
  top: 30px;
  left: 36px;
  width: 89px;
  transform: rotate(32deg);
}

.line-two {
  top: 96px;
  left: 35px;
  width: 105px;
  transform: rotate(-34deg);
}

.line-three {
  top: 34px;
  left: 120px;
  width: 75px;
  transform: rotate(100deg);
}

.symbol-node {
  position: absolute;
  z-index: 1;
  width: 13px;
  height: 13px;
  border: 3px solid #fff;
  border-radius: 50%;
  background: #6e96d4;
  box-shadow: 0 0 0 1px #9db8e2;
}

.node-one {
  top: 21px;
  left: 27px;
}

.node-two {
  top: 91px;
  left: 28px;
}

.node-three {
  top: 24px;
  left: 116px;
}

.node-four {
  top: 95px;
  left: 125px;
}

.symbol-core {
  position: absolute;
  top: 42px;
  left: 66px;
  z-index: 2;
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border: 4px solid #fff;
  border-radius: 13px;
  background: #3869bd;
  box-shadow: 0 3px 12px rgba(43, 81, 139, 0.2);
  color: #fff;
  font-size: 22px;
  font-weight: 750;
}

/* Metric cards */

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-top: 22px;
}

.metric-card {
  min-width: 0;
  padding: 19px 19px 17px;
  border: 1px solid #e3e7ed;
  border-radius: 10px;
  background: #fff;
}

.metric-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.metric-icon {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border-radius: 8px;
  font-size: 17px;
}

.metric-icon.blue {
  background: #eaf1ff;
  color: #416db7;
}

.metric-icon.purple {
  background: #f0ebff;
  color: #7860bb;
}

.metric-icon.green {
  background: #e8f5ee;
  color: #398461;
}

.metric-icon.amber {
  background: #fff3df;
  color: #ae8031;
}

.metric-label {
  color: #8993a3;
  font-size: 9px;
  font-weight: 750;
  letter-spacing: 0.9px;
}

.metric-value {
  display: block;
  margin-top: 16px;
  color: #293445;
  font-size: 27px;
  font-weight: 720;
  letter-spacing: -0.7px;
}

.metric-card p {
  margin-top: 4px;
  color: #8993a3;
  font-size: 11px;
}

/* Feature section */

.section-block {
  margin-top: 33px;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 15px;
}

.section-heading h2 {
  margin: 0;
  color: #293445;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.3px;
}

.section-heading p {
  margin: 6px 0 0;
  color: #8590a0;
  font-size: 12px;
  line-height: 1.6;
}

.section-caption {
  color: #8994a4;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.9px;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
}

.feature-card {
  display: flex;
  min-width: 0;
  min-height: 190px;
  flex-direction: column;
  align-items: flex-start;
  padding: 19px 17px 15px;
  border: 1px solid #e1e6ed;
  border-radius: 10px;
  background: #fff;
  text-align: left;
  cursor: pointer;
  transition: border-color 0.15s ease, transform 0.15s ease;
}

.feature-card:hover {
  transform: translateY(-2px);
  border-color: #a9c0e7;
}

.feature-icon {
  display: grid;
  width: 37px;
  height: 37px;
  place-items: center;
  margin-bottom: 17px;
  border-radius: 9px;
  background: #edf3ff;
  color: #3e6cba;
  font-size: 20px;
}

.feature-title {
  color: #303b4b;
  font-size: 13px;
  font-weight: 700;
}

.feature-description {
  margin-top: 8px;
  color: #808b9b;
  font-size: 11px;
  line-height: 1.7;
}

.feature-link {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: auto;
  padding-top: 15px;
  color: #3869bd;
  font-size: 11px;
  font-weight: 650;
}

.feature-link span {
  font-size: 14px;
}

/* AI question form */

.question-section {
  margin-top: 31px;
}

.ai-label {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 7px 9px;
  border: 1px solid #e1e9f7;
  border-radius: 6px;
  background: #f4f7fc;
  color: #5676aa;
  font-size: 9px;
  font-weight: 750;
  letter-spacing: 0.5px;
}

.ai-label span {
  font-size: 13px;
}

.question-form {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 10px 11px 10px 16px;
  border: 1px solid #dce3ec;
  border-radius: 9px;
  background: #fff;
}

.question-form:focus-within {
  border-color: #8eaddf;
  box-shadow: 0 0 0 3px rgba(66, 111, 188, 0.08);
}

.question-icon {
  color: #5b7fba;
  font-size: 18px;
}

.question-form input {
  flex: 1;
  min-width: 0;
  padding: 9px 0;
  border: 0;
  outline: none;
  background: transparent;
  color: #293445;
  font: inherit;
  font-size: 12px;
}

.question-form input::placeholder {
  color: #9ba4b1;
}

.question-form button,
.primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 11px 15px;
  border: 1px solid #3263b5;
  border-radius: 7px;
  background: #3869bd;
  color: #fff;
  font: inherit;
  font-size: 11px;
  font-weight: 650;
  cursor: pointer;
  transition: background 0.15s ease;
}

.question-form button:hover,
.primary-button:hover {
  background: #2c559d;
}

.question-form button:disabled {
  border-color: #b8c6dc;
  background: #b8c6dc;
  cursor: not-allowed;
}

.form-hint {
  margin: 9px 0 0 3px;
  color: #8a95a5;
  font-size: 10px;
}

/* Secondary pages */

.placeholder-page {
  display: flex;
  min-height: 430px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 34px;
  border: 1px solid #e2e7ee;
  border-radius: 12px;
  background: #fff;
}

.placeholder-icon {
  display: grid;
  width: 51px;
  height: 51px;
  place-items: center;
  margin-bottom: 24px;
  border-radius: 12px;
  background: #edf3ff;
  color: #3869bd;
  font-size: 25px;
}

.placeholder-page h1 {
  font-size: 30px;
}

.placeholder-description {
  max-width: 500px;
  margin: 12px 0 22px;
  color: #788496;
  font-size: 13px;
  line-height: 1.8;
}

.question-preview {
  width: 100%;
  max-width: 570px;
  box-sizing: border-box;
  margin: 0 0 20px;
  padding: 16px;
  border: 1px solid #e1e7ef;
  border-radius: 8px;
  background: #f8fafd;
}

.question-preview span {
  color: #79879b;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.7px;
}

.question-preview p {
  margin-top: 9px;
  color: #303b4b;
  line-height: 1.7;
}

.page-footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 36px;
  padding: 18px 0 3px;
  border-top: 1px solid #e4e8ee;
  color: #929cab;
  font-size: 10px;
}

.footer-dot {
  margin: 0 4px;
  color: #b3bbc7;
}

/* Responsive layout */

@media (min-width: 1500px) {
  .page-content {
    padding-right: 46px;
    padding-left: 46px;
  }
}

@media (max-width: 1150px) {
  .sidebar {
    width: 220px;
    flex-basis: 220px;
  }

  .page-content {
    padding-right: 24px;
    padding-left: 24px;
  }

  .topbar {
    padding-right: 24px;
    padding-left: 24px;
  }

  .metrics-grid,
  .feature-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .welcome-symbol {
    margin-right: 0;
  }
}

@media (max-width: 760px) {
  .sidebar {
    width: 66px;
    flex-basis: 66px;
    padding: 18px 8px 10px;
  }

  .brand {
    justify-content: center;
    padding: 0;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    flex-basis: 40px;
  }

  .brand-copy,
  .workspace-copy,
  .switcher-arrow,
  .nav-heading,
  .nav-item > span:not(.nav-icon),
  .connection-status,
  .profile-copy,
  .profile-menu {
    display: none;
  }

  .workspace-switcher {
    justify-content: center;
    margin: 25px 0;
    padding: 8px 0;
    border-color: transparent;
    background: transparent;
  }

  .nav-item {
    justify-content: center;
    padding: 0;
  }

  .nav-icon {
    font-size: 19px;
  }

  .profile {
    justify-content: center;
    padding-top: 14px;
  }

  .topbar {
    height: 58px;
    padding: 0 15px;
  }

  .page-content {
    padding: 20px 14px;
  }

  .welcome-section {
    padding: 23px 19px;
  }

  .welcome-symbol {
    display: none;
  }

  .welcome-section h1 {
    font-size: 28px;
  }

  .metrics-grid {
    gap: 10px;
  }

  .metric-card {
    padding: 14px;
  }

  .metric-label {
    font-size: 8px;
  }

  .feature-grid {
    gap: 10px;
  }

  .feature-card {
    min-height: 185px;
    padding: 15px 12px;
  }

  .question-form {
    flex-wrap: wrap;
  }

  .question-form input {
    flex-basis: calc(100% - 40px);
  }

  .question-form button {
    width: 100%;
  }

  .placeholder-page {
    min-height: 350px;
    padding: 24px;
  }

  .page-footer {
    flex-wrap: wrap;
  }
}

@media (max-width: 400px) {
  .metrics-grid,
  .feature-grid {
    grid-template-columns: 1fr;
  }

  .metric-card {
    min-height: 100px;
  }

  .topbar-actions {
    gap: 8px;
  }

  .environment-label {
    font-size: 0;
  }

  .environment-label .status-dot {
    width: 8px;
    height: 8px;
  }
}



/* Dataset management and spreadsheet upload */

.page-intro {
  margin-bottom: 28px;
}

.page-intro h1 {
  margin: 8px 0;
  font-size: clamp(28px, 3vw, 36px);
  letter-spacing: -1px;
}

.page-intro > p:last-child {
  max-width: 680px;
  color: var(--color-muted);
  line-height: 1.7;
}

.upload-panel {
  padding: 24px;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  background: var(--color-surface);
}

.upload-form {
  display: grid;
  gap: 16px;
}

.file-picker-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 170px;
  padding: 24px;
  border: 1px dashed #b8c5d6;
  border-radius: 10px;
  background: #fafbfd;
  text-align: center;
  cursor: pointer;
}

.file-picker-label:hover {
  border-color: var(--color-primary);
  background: #f5f8fd;
}

.file-picker-label strong {
  overflow-wrap: anywhere;
}

.file-picker-label > span:last-child {
  color: var(--color-muted);
  font-size: 13px;
  line-height: 1.6;
}

.upload-icon {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border-radius: 10px;
  background: #eaf0fb;
  color: var(--color-primary);
  font-size: 25px;
}

.upload-form input[type='file'] {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.upload-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10px;
}

.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 9px 14px;
  border: 1px solid var(--color-border);
  border-radius: 7px;
  background: white;
  color: var(--color-text);
  font-weight: 600;
  cursor: pointer;
}

.secondary-button:hover:not(:disabled) {
  background: #f5f7fa;
  border-color: #c3ccd8;
}

.secondary-button:disabled,
.primary-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.upload-progress {
  display: grid;
  gap: 8px;
}

.upload-progress-heading {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: var(--color-muted);
  font-size: 13px;
}

.upload-progress-heading strong {
  color: var(--color-text);
}

.upload-progress progress {
  width: 100%;
  height: 8px;
  accent-color: var(--color-primary);
}

.upload-feedback {
  padding: 14px 16px;
  border: 1px solid var(--color-border);
  border-radius: 8px;
}

.upload-feedback p {
  margin: 5px 0 0;
  overflow-wrap: anywhere;
  line-height: 1.6;
}

.upload-feedback.error {
  border-color: #edc7c7;
  background: #fff7f7;
  color: #a32929;
}

.upload-feedback.success {
  border-color: #c8e4d1;
  background: #f5fbf6;
  color: #226a3a;
}

.dataset-message {
  padding: 20px 0;
  color: var(--color-muted);
}

.dataset-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 35px 20px;
  border: 1px solid var(--color-border);
  border-radius: 10px;
  background: var(--color-surface);
  text-align: center;
}

.dataset-empty h3,
.dataset-empty p {
  margin: 0;
}

.dataset-empty p {
  margin-bottom: 8px;
  color: var(--color-muted);
  line-height: 1.6;
}

.dataset-table-wrap {
  width: 100%;
  overflow-x: auto;
  border: 1px solid var(--color-border);
  border-radius: 10px;
  background: var(--color-surface);
}

.dataset-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.dataset-table th,
.dataset-table td {
  padding: 14px 16px;
  border-bottom: 1px solid var(--color-border);
  white-space: nowrap;
}

.dataset-table th {
  background: #f8f9fb;
  color: var(--color-muted);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
}

.dataset-table td {
  font-size: 13px;
}

.dataset-table tbody tr:last-child td {
  border-bottom: 0;
}

.dataset-table tbody tr:hover {
  background: #fafbfd;
}

.dataset-name-cell {
  display: flex;
  align-items: center;
  gap: 11px;
  white-space: normal;
}

.dataset-name-cell > span:last-child {
  display: grid;
  gap: 4px;
}

.dataset-name-cell strong {
  overflow-wrap: anywhere;
}

.dataset-name-cell small {
  color: var(--color-muted);
  font-size: 11px;
}

.dataset-file-icon {
  display: grid;
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  place-items: center;
  border-radius: 8px;
  background: #edf3ff;
  color: var(--color-primary);
  font-size: 18px;
}

.dataset-table code {
  color: #526174;
  font-size: 12px;
}

@media (max-width: 640px) {
  .upload-panel {
    padding: 16px;
  }

  .upload-actions {
    flex-direction: column;
  }

  .upload-actions button {
    width: 100%;
  }

  .dataset-table th,
  .dataset-table td {
    padding: 12px;
  }
}
/* npm run build */
